  ],
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/commander": "^2.12.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.3",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "adm-zip": "^0.5.18",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.3",
    "docx": "^9.7.1",
    "docx-templates": "^4.15.0",
    "docxtemplater": "^3.68.7",
