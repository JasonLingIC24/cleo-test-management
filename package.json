    "eslint:check-strict": "eslint --max-warnings=0 . --ext .js,.jsx,.ts,.tsx",
    "eslint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "prettier:check": "prettier \"**/*.{ts,tsx,html,json,md,js}\" -c",
    "prettier:fix": "prettier \"**/*.{ts,tsx,html,json,md,js}\" -c --write"
